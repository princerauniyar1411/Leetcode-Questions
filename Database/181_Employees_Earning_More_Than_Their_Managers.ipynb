      "source": [
        "SELECT\n",
        "    e.name AS Employee\n",
        "FROM Employee AS e\n",
        "INNER JOIN Employee AS m\n",
        "    ON e.managerId = m.id\n",
        "WHERE e.salary > m.salary;"
      ]
    }
  ]
